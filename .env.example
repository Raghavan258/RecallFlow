# Copy to .env at the repository root. Never commit real API keys.

# SQLite path is resolved relative to the backend/ directory.
DATABASE_URL=sqlite:///./data/recallflow.db

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# baseline works offline. Set to llm only when LLM_API_KEY is configured.
EXTRACTION_PROVIDER=baseline

# Optional OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
